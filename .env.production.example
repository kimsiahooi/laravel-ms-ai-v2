# Production environment for kimsiah.site.
#
# Copy to `.env` on the server and fill in every <…>. This is NOT .env.example with the
# values changed: it also carries the keys this app reads but never lists there, which is
# how they end up wrong in production and right everywhere else.
#
# See docs/DEPLOYMENT.md.

APP_NAME="Inventory System"
APP_ENV=production
# Generated ON THE SERVER with `php artisan key:generate`, and NEVER rotated afterwards.
# PASSKEYS_USER_HANDLE_SECRET falls back to this key (config/fortify.php), so changing it
# invalidates every passkey anybody has registered.
APP_KEY=
APP_DEBUG=false
APP_URL=https://kimsiah.site

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` would write every query and every request to disk on a live box.
LOG_LEVEL=warning

# Every value reading CHANGEME below is a placeholder. They carry no spaces on purpose: a
# dotenv value with unquoted whitespace makes the whole file unparseable, and the failure
# surfaces as `package:discover` aborting inside `composer install` — an error that says
# nothing about .env at all. Before deploying, check none are left:
#
#     grep -nE '^[A-Z_]+=.*CHANGEME' .env
#
# --- Database -----------------------------------------------------------------------
#
# DB_CONNECTION is `central`, not `mysql`, and that is load-bearing rather than a name:
# stancl clones this connection at runtime into one literally called `tenant`, and
# config/tenancy.php reads `env('DB_CONNECTION', 'central')` as the central connection.
#
# The user below needs GLOBAL `CREATE DATABASE` and `DROP DATABASE`, because this app
# provisions one database per workspace. CloudPanel's generated per-site user does NOT
# have that — see docs/DEPLOYMENT.md for the grant.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGEME_central
DB_USERNAME=CHANGEME_user
DB_PASSWORD=CHANGEME

# Prefix for the per-workspace databases: slug `acme` becomes `<prefix>acme`.
# Set explicitly so a second tenanted app on this box can never resolve to the same
# database as this one.
TENANCY_DB_PREFIX=inv_tenant_

# --- Session / cache / queue --------------------------------------------------------
#
# All three are MySQL. There is no Redis on this box and no queue worker — see the queue
# note at the bottom.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Stays null so the cookie is host-only. Setting `.kimsiah.site` would hand this app's
# session cookie to every subdomain, including the other Laravel app planned for one.
SESSION_DOMAIN=null
# Not set by default, so cookies are NOT marked Secure until you say so.
SESSION_SECURE_COOKIE=true
# A distinct name, so two Laravel apps on this domain cannot argue over one cookie.
SESSION_COOKIE=inventory_session

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# --- Inertia SSR ---------------------------------------------------------------------
#
# Must match `inertia({ ssr: { host, port } })` in vite.config.ts — that is what the built
# bundle binds, and it is baked in at build time. If they disagree, Laravel posts into a
# closed port and silently falls back to client rendering with nothing logged.
#
# The next Laravel app on this box takes 13715.
INERTIA_SSR_URL=http://127.0.0.1:13714

# --- Files and media -----------------------------------------------------------------
#
# Uploads go to the private `assets` disk at storage/assets/{workspace}/…, served only
# through an authenticated route. It is deliberately never symlinked into public/.
FILESYSTEM_DISK=local
MEDIA_DISK=assets
# `gd` is enough for the 256px product thumbnail; set `imagick` only if it is installed.
IMAGE_DRIVER=gd
# False, deliberately: nothing runs a queue worker, so a queued conversion is a thumbnail
# that never appears and an error nobody sees. Flip this ONLY alongside `queue:work`.
QUEUE_CONVERSIONS_BY_DEFAULT=false

# --- Mail ------------------------------------------------------------------------------
#
# Real SMTP is required, not optional: password resets and email verification go through
# here, and the default `log` mailer means they silently go nowhere.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_FROM_ADDRESS="no-reply@kimsiah.site"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
